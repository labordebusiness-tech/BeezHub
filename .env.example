# ----------------------------------------------------------------------
# Configuration Level Up — copie ce fichier en ".env" et remplis les valeurs
# (le fichier .env ne doit JAMAIS être commité : il est dans .gitignore)
# ----------------------------------------------------------------------

# Clé SECRÈTE Stripe (Dashboard Stripe → Développeurs → Clés API)
# Test : sk_test_...   |   Production : sk_live_...
STRIPE_SECRET_KEY=sk_test_REMPLACER_PAR_TA_CLE_SECRETE

# (Optionnel) Secret du webhook Stripe, si tu actives /webhook plus tard
# STRIPE_WEBHOOK_SECRET=whsec_REMPLACER

# URL publique du site (utilisée pour les redirections après paiement)
# En local laisse vide. En production : https://ton-domaine.com
DOMAIN=http://localhost:4242

# Port du serveur (optionnel)
PORT=4242
